  "types": [
    {
      "name": "Payment",
      "docs": [
        "The on-chain record of a locked payment.",
        "",
        "Everything that identifies a payment — sender, receiver, mint, secret hash, lock time and",
        "amount — is in the PDA seeds, so the address itself is the commitment and none of it has to be",
        "stored or re-validated here. The account exists to (a) prove the payment was made and (b) hold",
        "the funds, and it is closed when the payment is spent or refunded so the rent goes back."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "bump",
            "docs": [
              "Canonical bump of this PDA, stored so spend/refund don't have to re-derive it."
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "PaymentRefunded",
      "docs": [
        "Emitted when the sender reclaims a payment after the lock time expired."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "payment",
            "type": "pubkey"
          },
          {
            "name": "sender",
            "type": "pubkey"
          },
          {
            "name": "amount",
            "type": "u64"
          }
        ]
      }
    },
    {
      "name": "PaymentSent",
      "docs": [
        "Emitted when funds are locked. Indexers (and the Komodo DeFi Framework's swap watcher) use these",
        "to find payments and their outcomes, since the payment account is closed once it is settled."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "payment",
            "type": "pubkey"
          },
          {
            "name": "sender",
            "type": "pubkey"
          },
          {
            "name": "receiver",
            "type": "pubkey"
          },
          {
            "name": "mint",
            "docs": [
              "`None` for native SOL payments."
            ],
            "type": {
              "option": "pubkey"
            }
          },
          {
            "name": "amount",
            "type": "u64"
          },
          {
            "name": "lock_time",
            "type": "u64"
          },
          {
            "name": "secret_hash",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          }
        ]
      }
    },
    {
      "name": "PaymentSpent",
      "docs": [
        "Emitted when the receiver claims a payment by revealing the secret."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "payment",
            "type": "pubkey"
          },
          {
            "name": "receiver",
            "type": "pubkey"
          },
          {
            "name": "amount",
            "type": "u64"
          },
          {
            "name": "secret",
            "docs": [
              "The revealed preimage. The counterparty needs this to claim the other side of the swap."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          }
        ]
      }
    }
  ]
